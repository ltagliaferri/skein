<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SKEIN service as a macOS launchd user agent. Rendered by the print-plist
  flag of skein-server; install into
  ~/Library/LaunchAgents/net.interskein.skein-server.plist and load with
  launchctl (see the README). ProgramArguments is rendered to the exact
  install doing the printing, like the systemd unit's ExecStart.
  (An XML comment cannot contain a double hyphen, hence the flag spellings.)

  To bind somewhere other than 127.0.0.1:8001, write the address into
  SKEIN_HOME/server.json (for example {"port": 8123}), the one source both
  this service and the skein CLI read, so both ends move together. An entry
  in EnvironmentVariables below reaches only the service process; the CLI in
  your shell never sees it, so it cannot move the address without stranding
  the CLI on the old one. The same goes for SKEIN_HOME itself: set here, it
  must match what the CLI uses (its own SKEIN_HOME, or ~/.skein), or the two
  read different homes; skein doctor flags that mismatch.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>net.interskein.skein-server</string>
	<key>ProgramArguments</key>
	<array>
__SKEIN_SERVER_ARGS__
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>
	<key>StandardOutPath</key>
	<string>__SKEIN_LOG_PATH__</string>
	<key>StandardErrorPath</key>
	<string>__SKEIN_LOG_PATH__</string>
</dict>
</plist>
