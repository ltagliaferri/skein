[Unit]
Description=SKEIN Server (Structured Knowledge Exchange & Integration Nexus)
After=network.target

[Service]
Type=simple
Environment="PYTHONUNBUFFERED=1"
# The packaged console script. It resolves project data through the registry at
# <SKEIN_HOME>/projects.json, never relative to a working directory, so there is
# nothing here that has to point at a source checkout. This is what makes the
# unit usable from a plain `uv tool install interskein`.
ExecStart=__SKEIN_SERVER__
# To bind somewhere other than 127.0.0.1:8001, write the address into
# <SKEIN_HOME>/server.json (e.g. {"port": 8123}) — the one source both this
# service and the `skein` CLI read, so both ends move together.
# An Environment= line here reaches only the service process — the CLI in
# your shell never sees it, so it cannot move the address without stranding
# the CLI on the old one.
# SKEIN_HOME below must match what the CLI uses ($SKEIN_HOME or ~/.skein);
# `skein doctor` flags a mismatch.
#Environment="SKEIN_HOME=%h/.skein"
Restart=on-failure
RestartSec=5

KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=default.target
